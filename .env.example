# Copy to ../.env (outside the repo) or .env, and fill in. NEVER commit real values.
# Use a throwaway TESTNET-ONLY key. Aevum Testnet has no real value.
PRIVATE_KEY=
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
WALLET_CHANGE_COOLDOWN=3600
FEE_BPS=30

# --- agent service (agent/) ---
# Google Gemini API key (free tier). Optional: without it the agent uses the deterministic rule parser.
GEMINI_API_KEY=
# Optional overrides: model fallback list, client-side rate limits (keep under your free-tier quota)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_RPM=10
GEMINI_DAILY_CAP=200
# Session key the AI clerk signs with (testnet only; the owner registers its ADDRESS via createSession)
CLERK_PRIVATE_KEY=
BUNDLER_URL=http://127.0.0.1:4337
NGN_PER_USD=1500
