# Copy to ../.env (outside the repo) or .env, and fill in. NEVER commit real values.
# Use a throwaway TESTNET-ONLY key. Aevum Testnet has no real value.
PRIVATE_KEY=
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
WALLET_CHANGE_COOLDOWN=3600
FEE_BPS=30

# --- agent service (agent/) ---
# Google Gemini API key (free tier). Optional: without it the agent uses the deterministic rule parser.
GEMINI_API_KEY=
# Optional overrides: model fallback list, client-side rate limits (keep under your free-tier quota)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_RPM=10
GEMINI_DAILY_CAP=200
# Session key the AI clerk signs with (testnet only; the owner registers its ADDRESS via createSession)
CLERK_PRIVATE_KEY=
BUNDLER_URL=http://127.0.0.1:4337
NGN_PER_USD=1500

# --- web app server (agent/src/server.ts serves the owner console, pay page and API) ---
# REQUIRED before listening on anything but localhost. Long random string; the owner types it once per device.
OWNER_TOKEN=
# Testnet owner of the SME smart account (defaults to PRIVATE_KEY). Signs owner userOps server-side.
OWNER_PRIVATE_KEY=
# Pays gas for customers' gasless invoice payments (defaults to PRIVATE_KEY)
RELAYER_PRIVATE_KEY=
# Optional: a verified payee wallet that issues invoices from "Get paid"
MERCHANT_PRIVATE_KEY=
# Optional: testnet customer for the one-tap judge demo payment on the pay page
DEMO_CUSTOMER_PRIVATE_KEY=
# 1 = read-only judge mode: live chain reads, simulated writes, chat never signs (safe to host publicly)
DEMO_MODE=
HOST=127.0.0.1
PORT=8787
# docker-compose: relayer key for the bundler container, optional shared bearer token between server and bundler
BUNDLER_PRIVATE_KEY=
BUNDLER_TOKEN=
